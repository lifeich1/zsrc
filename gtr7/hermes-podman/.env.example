# 复制为 .env 后按需修改：cp .env.example .env
# .env 已被仓库根 .gitignore 排除，不要提交。
#
# 注意：API key / 平台 token 不在这里。它们在 Hermes 自己的
# ${HERMES_DATA_DIR}/.env 中，由首次 setup 向导写入：
#   podman-compose run --rm hermes setup

# Hermes 持久化数据目录（配置、密钥、sessions、skills、logs）
HERMES_DATA_DIR=/home/fool/.hermes

# 容器内 hermes 服务以宿主用户身份运行（`id -u` / `id -g`），
# 保证写回 calory/data 的文件属主仍是 fool
PUID=1000
PGID=100

TZ=Asia/Shanghai

# ---- dashboard（局域网给 Hermes 客户端 / 手机浏览器用）----
# 非回环绑定会强制认证：缺任一项 dashboard 会 fail closed 起不来。
# 密码只留在本地 .env（已 gitignore）；也可改用
# HERMES_DASHBOARD_BASIC_AUTH_PASSWORD_HASH 放 scrypt 哈希代替明文。
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=admin
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=
# 稳定签名密钥，缺了它每次重启都会掉登录：openssl rand -base64 32
HERMES_DASHBOARD_BASIC_AUTH_SECRET=

# dashboard 监听地址：0.0.0.0 = 局域网所有网卡；也可填局域网 IP 或 Tailscale IP
HERMES_DASHBOARD_BIND=0.0.0.0
