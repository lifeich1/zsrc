#!/bin/sh
# calory 入口 wrapper —— 容器内直接 `cal <子命令>`。
#
# 官方 hermes-agent 镜像基于 debian:13.4，Python 3.13 装在
# /opt/hermes/.venv/bin/python，系统里不保证有 python3，
# 所以这里在运行时挑一个 >= 3.10 的解释器。
# 数据根目录由 compose 注入的 CALORY_HOME 决定（默认 /calory）。

set -e

CALORY_DIR="${CALORY_HOME:-/calory}"

pick_python() {
    for candidate in python3 /usr/bin/python3 /opt/hermes/.venv/bin/python; do
        if [ -x "$candidate" ] || command -v "$candidate" >/dev/null 2>&1; then
            if "$candidate" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 10) else 1)' 2>/dev/null; then
                printf '%s\n' "$candidate"
                return 0
            fi
        fi
    done
    return 1
}

PY="$(pick_python || true)"
if [ -z "$PY" ]; then
    echo "cal: 找不到 Python >= 3.10 解释器（calory 需要 3.10+）" >&2
    exit 127
fi

exec "$PY" "$CALORY_DIR/cal" "$@"
